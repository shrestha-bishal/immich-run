# .upload-templates.env
# ---------------------
# This file contains upload templates for immich-go.
# Each variable is a template name and its value should include
# only immich-go flags/arguments.
# DO NOT include --server or --api-key; those are automatically
# added by upload.sh from your .env.
#
# Example:
# dry_run="--dry-run"

dry_run="--dry-run"
