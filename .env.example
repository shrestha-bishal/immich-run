# Immich server URL
IMMICH_SERVER=http://localhost:2283

# Immich API key (required)
IMMICH_API_KEY=your_api_key_here

# Path to immich-go executable
IMMICH_GO_EXECUTABLE=/home/immich/immich-go

# GoPro LRV handling:
# When set to true:
#   - If a matching .MP4 exists → delete the .LRV file
#   - If NO matching .MP4 exists → keep and move the .LRV to the gopro folder
#
# When set to false:
#   - Never delete .LRV files
#   - Always keep and move .LRV files to the gopro folder
GOPRO_DELETE_LRV_IF_MP4_EXISTS=true